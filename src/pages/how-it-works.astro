---
import BaseLayout from '~/layouts/BaseLayout.astro'
import SectionHead from '~/components/SectionHead.astro'
import AssetTag from '~/components/AssetTag.astro'
import { ASSETS, SITE, type AssetId } from '~/data/site'

const assetOrder: AssetId[] = ['metanorma', 'pubid', 'relaton', 'glossarist', 'lutaml', 'primmel']

const passes = [
  {
    name: 'Corpus assembly, with provenance',
    body: 'The corpus is assembled from the organization’s authored sources. Every chunk records where it came from, together with its publication, edition, language and a quality tier, so every later stage can be held to the record.',
  },
  {
    name: 'Clause-boundary chunking',
    body: 'Documents are split along their own clause structure — the structure the authors wrote — rather than by fixed-length token windows. Every chunk carries its clause number, so a citation can name an exact location in the source document.',
  },
  {
    name: 'Contextual enrichment',
    body: 'A one-time pass writes each chunk a short preamble stating where it sits: publication, part, clause, subject. The pass is recorded, so it replays exactly after any rebuild — enrichment lives in the index, not in transient artifacts.',
  },
  {
    name: 'Typed units',
    body: 'Tables, formulas and figures are extracted as first-class retrievable objects alongside the prose. A formula keeps its source notation; a table keeps its columns and rows as data; a figure keeps its original drawing.',
  },
  {
    name: 'Terminology and bibliographic binding',
    body: 'Defined terms link to the clauses that define them, and the bibliographic registry organizes publication families with their editions and supersession links, so which edition is in force is answered from the record. The registry is joined by a citation graph: what each edition’s bibliography cites is extracted as a graph edge, so a question of the form “which standards does this publication reference” is answered from the record rather than by hoping a text search finds the bibliography section.',
  },
  {
    name: 'The model plane',
    body: 'Where the publications carry machine-readable models, the models themselves are indexed: typed attributes, constraints with numeric limits, calculations and test sequences. This is what allows the system to execute a rule instead of quoting it.',
  },
]

const serving = [
  {
    name: 'Understanding',
    body: 'A language model reads the question first: its language, any publication or edition it names, whether it asks about a defined term, and what earlier turns contribute. The same model makes these judgements for every question.',
  },
  {
    name: 'Retrieval',
    body: 'The question expands into several search forms — reworded variants and a draft answer as an additional key — run against a hybrid dense-plus-lexical index, fused by rank. Two structure-aware lanes add their own candidates: the terminology graph contributes the clauses that define a term when the question is about one, and the citation graph supplies the list of cited standards as structured data when the question asks what a publication cites, with the bibliography section retrieved as the passage that grounds it.',
  },
  {
    name: 'Ranking over structure',
    body: 'A cross-encoder orders the candidates. Because the corpus is a clause tree, a clause’s score also blends its neighbours’: a section whose clauses are collectively relevant rises. Evidence reaches the answer model in document reading order, and near-duplicates from one clause chain collapse.',
  },
  {
    name: 'Vocabulary binding',
    body: 'Everyday words rarely match defined terms. The terminology index links the member’s phrasing to candidate terms; the answer then leads with the corpus’s own term, quotes its definition and cites where it is defined.',
  },
  {
    name: 'Answering under contract',
    body: 'The answer is generated from the retrieved passages only, under a contract that requires an inline citation on every claim and verbatim quotes for normative values. Typed objects render from source; the model never retypes them.',
  },
  {
    name: 'Checking',
    body: 'A judge grades whether the passages support the answer, and a second check scores faithfulness. Failed checks trigger one corrected retry. Answers that remain unsupported are withheld rather than shown.',
  },
  {
    name: 'Conformance by execution',
    body: 'A question that names a machine-checkable rule gets the rule evaluated. Values bind to the rule’s parameters, the check runs deterministically, and the verdict — with the arithmetic shown — is attached as data the model must present faithfully.',
  },
]
---

<BaseLayout
  title="How it works"
  description="The machinery of Konneal in three parts: the assets you bring, the annealment passes that run over them, and the gates that decide what ships."
>
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 pb-12 pt-14 sm:px-8 sm:pt-16">
      <h1 class="mt-4 max-w-3xl font-sans text-[2.1rem] font-semibold leading-[1.1] tracking-[-0.01em] sm:text-[2.7rem]">
        How Konneal works
      </h1>
      <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-ink-soft">
        The <strong class="font-medium text-ink">assets</strong> are the artifacts your organization has already
        authored. The <strong class="font-medium text-ink">passes</strong> are the pipeline stages that bind that
        structure into the indexes the service queries. The <strong class="font-medium text-ink">gates</strong> are
        the measurements that decide whether a change ships. The pipeline runs in one direction, and every stage
        leaves a record.
      </p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="What you bring"
        lede="Each asset below is structure the organization has already authored. Every one of them raises what the serving layer can do, and the library alone is enough to begin."
      />
      <div class="mt-10 grid gap-px overflow-hidden border border-rule bg-rule md:grid-cols-2 lg:grid-cols-3">
        {
          assetOrder.map((id) => (
            <div class="bg-surface p-6">
              <AssetTag id={id} />
              <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">{ASSETS[id].what}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-sm text-ink-faint">
        The suite makes the ladder possible: documents authored in Metanorma give the corpus its spine; rules modelled
        in Primmel give it machines to run. Each layer of structure makes a specific range of capability possible,
        and the serving layer multiplies what is there.
        <a href="/annealment/" class="text-blue underline decoration-rule underline-offset-4 hover:decoration-keyline">The measurement is documented on the annealment page</a>.
      </p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="The annealment passes"
        lede="From publications to the index, each pass adds verified structure and leaves a record it can be replayed from."
      />
      <ol class="mt-10 grid gap-px overflow-hidden border border-rule bg-rule md:grid-cols-2">
        {
          passes.map((s, i) => (
            <li class="bg-surface p-7">
              <p class="font-mono text-[0.72rem] text-blue">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 font-sans text-[1.1rem] font-semibold">{s.name}</h3>
              <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink-soft">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-5 text-sm text-ink-faint">
        Everything meets in one vector index under a declared contract: a single validated boundary enforces the wire
        schema and the legal metadata shapes, and public and access-restricted content live in physically separate
        indexes — separation that holds structurally, not by a filter that could be forgotten.
      </p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="What happens when you ask"
        lede="Seven stages, in order."
      />
      <ol class="mt-10 space-y-0">
        {
          serving.map((s, i) => (
            <li class="grid gap-3 border-t border-rule py-6 sm:grid-cols-[4.5rem_minmax(0,1fr)_minmax(0,1.4fr)] sm:gap-6">
              <p class="font-mono text-[0.85rem] font-medium text-blue">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="font-sans text-[1.1rem] font-semibold leading-snug">{s.name}</h3>
              <p class="text-[0.92rem] leading-relaxed text-ink-soft">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="What decides whether anything ships"
        lede="A golden suite decides whether a change ships."
      />
      <div class="mt-8 max-w-3xl space-y-4 text-[0.95rem] leading-relaxed text-ink-soft">
        <p>
          A golden question set with expected citations and witnesses runs end to end — three times — before any
          change is promoted, with paraphrase probes and leakage probes alongside. Grading is deterministic wherever
          possible: expected spans must appear in retrieved passages, and judged components are labeled as judged.
        </p>
        <p>
          The gates never run while the index is being modified, because an honest measurement requires a settled
          system. Every retrieval change bumps the index version, so no answer is served from a superseded index.
        </p>
        <p>
          Deploys run from CI on merge, and a smoke probe questions the live service before a deploy is called done.
        </p>
        <p>
          Two capabilities go beyond answering and can be tried directly: conformance by execution, and the checking of
          any answer against the corpus. Both run as in-page demonstrations on
          <a href="/use-cases/" class="text-blue underline decoration-rule underline-offset-4 hover:decoration-keyline">the use cases page</a
          >.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead title="Platform and models" />
      <div class="mt-8 max-w-3xl space-y-4 text-[0.95rem] leading-relaxed text-ink-soft">
        <p>
          All models are open-weight. No corpus data is sent to third-party services, and the system has no dependency
          on a proprietary model provider. Different roles use different models, chosen for the job.
        </p>
        <p>
          The reference deployment runs on Cloudflare — Workers, Vectorize, D1, KV, R2 — with reference adapters in
          the engine. The design runs anywhere that provides model serving, vector search and durable storage.
        </p>
        <p>
          The service also exposes a conversational HTTP API and an MCP server for AI agents, with tools for grounded
          answers, passage search and the publication registry.
        </p>
        <p>
          The narrative for the reference corpus, written for its readers, is at
          <a
            href={SITE.reference.howItWorksUrl}
            class="text-blue underline decoration-rule underline-offset-4 hover:decoration-keyline"
            >{SITE.reference.name} — how it works ↗</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
