---
import '@fontsource-variable/source-serif-4'
import BaseLayout from '~/layouts/BaseLayout.astro'
import SectionHead from '~/components/SectionHead.astro'
import Staircase from '~/components/Staircase.astro'
import { SITE } from '~/data/site'

const ladder = [
  { rung: 'L0', name: 'Locate', probe: '“Where does R 60 address creep?”', witness: 'clause anchor' },
  { rung: 'L1', name: 'Extract', probe: 'a verbatim value from prose', witness: 'exact string' },
  { rung: 'L2', name: 'Nomenclature', probe: 'colloquial → defined term, across registers and languages', witness: 'term + register anchor' },
  { rung: 'L3', name: 'Geometry', probe: 'a table cell by row × column, unit-aware', witness: 'value + keys + unit kind' },
  { rung: 'L4', name: 'Composition', probe: 'joins within a document and across its parts', witness: 'both anchors + relation' },
  { rung: 'L5', name: 'Cross-standard', probe: 'cited external standards; composition and binding', witness: 'the linked id / clause' },
  { rung: 'L6', name: 'Diachrony', probe: 'current edition; deltas between editions; validity windows', witness: 'edition pair + delta fact' },
  { rung: 'L7', name: 'Perception', probe: 'labels readable only from the drawing itself', witness: 'pixel-only label' },
  { rung: 'L8', name: 'Computation', probe: 'conformance verdicts with the violation meaning', witness: 'computed offline — deterministic' },
  { rung: 'L9', name: 'Instance & process', probe: 'process order and its consequences', witness: 'order verdict — deterministic' },
]

const primitives = [
  ['P1', 'surface text'],
  ['P2', 'editorial anchoring'],
  ['P3', 'object geometry'],
  ['P4', 'nomenclature'],
  ['P5', 'relation'],
  ['P6', 'temporality'],
  ['P7', 'perception'],
  ['P8', 'quantitative typing'],
  ['P9', 'computation'],
  ['P10', 'instance & process'],
]

const eras = [
  { era: '1 · Legacy', rep: 'plain text', is: 'an index: find and restate', ceiling: 'L1–L3' },
  { era: '2 · Now', rep: 'typed units + machine models', is: 'a grounded instrument: cite, render, verify, compute', ceiling: 'L7 · models L9' },
  { era: '3 · Frontier', rep: 'executed models, closed world', is: 'an operator: verdict, simulate, prove, personalize', ceiling: 'beyond L9' },
]

const frontier = [
  {
    id: 'F1',
    name: 'Verdict as data',
    body: 'Pass, fail or void — the reason in the standard’s own words, and the full clause chain — produced by execution and verified by execution.',
  },
  {
    id: 'F2',
    name: 'Counterfactual simulation',
    body: 'Constraints and lookup formulas run on hypothetical parameters. Documents state facts; models evaluate hypotheses.',
  },
  {
    id: 'F3',
    name: 'Provable absence',
    body: 'The closed world turns “does the standard require this? — no” into a proof rather than a refusal: N nodes enumerated, zero matches.',
  },
  {
    id: 'F8',
    name: 'Self-verification',
    body: 'The model plane is machine-checked consistent, so the assistant can verify its own model-grounded claims by execution.',
  },
]
---

<BaseLayout
  title="Annealment"
  description="Knowledge annealment: the degree to which knowledge is bound into structure a machine can traverse and compute — the ladder L0–L9, the primitives P1–P10, and the measured staircase."
>
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 pb-14 pt-14 sm:px-8 sm:pt-16">
      <h1 class="mt-4 max-w-3xl font-sans text-[2.1rem] font-semibold leading-[1.1] tracking-[-0.01em] sm:text-[2.7rem]">
        Knowledge annealment
      </h1>
      <div class="serif-body mt-6 max-w-2xl">
        <p class="mt-4 text-[1.08rem] leading-[1.7] text-ink-soft">
          Annealment is the degree to which knowledge is bound into structure a machine can traverse and compute, and
          it is a property of the corpus rather than of the model. Repeated passes add verified structure to a corpus
          until it becomes measurable, citable and executable. K-onneal is short for knowledge annealment.
        </p>
        <p class="mt-4 text-[1.02rem] leading-[1.7] text-ink-soft">
          The metallurgy is the honest metaphor. Annealing is heat treatment that turns soft metal into a durable
          structure; annealment turns prose that a human must read and interpret into structure a machine can run.
          Models are open-weight and can be exchanged; the annealed corpus stays, and each pass adds further structure
          to it.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="Capability by corpus representation"
        lede="Measured directly: representations of the same corpus — the OIML R 60 family, in the reference deployment — indexed and graded on 18 witness-graded capability probes. Plain text answered two; the full annealed corpus, seventeen to eighteen. Representation quality and serving techniques multiply rather than add."
      />
      <div class="mt-10">
        <Staircase />
      </div>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="Ten rungs, L0 to L9"
        lede="Each rung is defined by which corpus primitives it requires, and graded by a witness — computed, never judged, at the upper rungs."
      />
      <div class="mt-10 overflow-x-auto">
        <table class="doc-table">
          <thead>
            <tr>
              <th>Rung</th>
              <th>Capability</th>
              <th>Representative probe</th>
              <th>Witness</th>
            </tr>
          </thead>
          <tbody>
            {
              ladder.map((r) => (
                <tr>
                  <td>{r.rung}</td>
                  <td class="font-sans font-medium text-ink">{r.name}</td>
                  <td class="font-sans">{r.probe}</td>
                  <td class="font-sans text-ink-soft">{r.witness}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-5 text-sm text-ink-faint">
        A lane’s <span class="font-medium text-ink-soft">capability ceiling</span> is the highest consecutive rung at
        ≥ 60 % witness-checked pass; its <span class="font-medium text-ink-soft">annealment index</span> is the
        fraction of primitive tiers its representation materializes.
      </p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        title="P1–P10"
        lede="The taxonomy the ladder is defined on. Editorially anchored text reaches P2; typed document models reach P7; machine models carry P8–P10 — quantitative typing, computation, instance and process."
      />
      <div class="mt-10 grid grid-cols-1 gap-px overflow-hidden border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-5">
        {
          primitives.map(([id, name]) => (
            <div class="bg-surface p-5">
              <p class="font-mono text-[0.8rem] font-medium text-blue">{id}</p>
              <p class="mt-1.5 text-[0.85rem] leading-snug text-ink-soft">{name}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead title="Three eras of the assistant" lede="The ladder places every answering system in one of three eras." />
      <div class="mt-10 overflow-x-auto">
        <table class="doc-table">
          <thead>
            <tr>
              <th>Era</th>
              <th>Representation</th>
              <th>The assistant is</th>
              <th>Ceiling</th>
            </tr>
          </thead>
          <tbody>
            {
              eras.map((e) => (
                <tr>
                  <td>{e.era}</td>
                  <td class="font-sans">{e.rep}</td>
                  <td class="font-sans">{e.is}</td>
                  <td class="font-sans text-ink-soft">{e.ceiling}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="on-night border-b border-night bg-night">
    <div class="mx-auto max-w-6xl px-5 py-14 text-ramp-hi sm:px-8">
      <div class="max-w-3xl">
        <h2 class="mt-3 font-sans text-[1.7rem] font-semibold leading-tight text-white sm:text-[2rem]">
          The corpus as a closed, executable model.
        </h2>
        <p class="mt-4 text-[1rem] leading-relaxed text-ramp-hi/80">
          The capabilities below exist because the corpus is a model with a closed world and executable semantics —
          no document representation can follow. All four serve the public today in the reference deployment.
        </p>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden border border-white/12 bg-white/12 md:grid-cols-2">
        {
          frontier.map((f) => (
            <article class="bg-night-soft p-7">
              <p class="font-mono text-[0.78rem] text-ramp-lo">{f.id}</p>
              <h3 class="mt-3 font-sans text-[1.15rem] font-semibold text-white">{f.name}</h3>
              <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ramp-hi/80">{f.body}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-ramp-hi/65">
        The full instrument — lanes, the golden set, rigor rules and the four-corpus comparison — is documented at the
        reference deployment:
        <a
          href={SITE.reference.annealmentUrl}
          class="text-ramp-lo underline underline-offset-4 hover:text-white"
          >{SITE.reference.name} — knowledge annealment ↗</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .serif-body p {
    font-family: var(--font-serif);
  }
</style>
