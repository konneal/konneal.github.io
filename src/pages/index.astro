---
import BaseLayout from '~/layouts/BaseLayout.astro'
import SectionHead from '~/components/SectionHead.astro'
import AnswerCard from '~/components/AnswerCard.astro'
import AssetTag from '~/components/AssetTag.astro'
import { INVENTORY, SITE, SUITE } from '~/data/site'
---

<BaseLayout title="Konneal">
  <!-- Thesis -->
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 pb-16 pt-16 sm:px-8 sm:pt-20">
      <div class="max-w-3xl">
        <p class="eyebrow rise"><span class="tick"></span>For standards organizations</p>
        <h1
          class="rise mt-5 font-sans text-[2.3rem] font-semibold leading-[1.08] tracking-[-0.015em] sm:text-[3.1rem]"
          style="animation-delay: 0.08s"
        >
          Konneal anneals your publications into a corpus a machine can traverse and compute.
        </h1>
        <p class="rise mt-6 max-w-2xl text-[1.06rem] leading-relaxed text-ink-soft" style="animation-delay: 0.16s">
          Konneal runs annealment passes over the publications your organization has already authored, and serves the
          result to your members as a question-answering service: every answer names the publication, edition and
          clause behind it, and where the rules carry machine-readable models, they are executed — with the arithmetic
          shown.
        </p>
        <p class="rise mt-5 max-w-2xl text-[0.95rem] leading-relaxed text-ink-faint" style="animation-delay: 0.2s">
          The method is measured: asked over plainer representations of the same corpus, the same questions answer two
          of eighteen capability probes; over the annealed corpus, seventeen to eighteen.
          <a
            href="/annealment/"
            class="text-blue underline decoration-rule underline-offset-4 hover:decoration-keyline">The measurement</a
          >.
        </p>
        <div class="rise mt-8 flex flex-wrap items-center gap-4" style="animation-delay: 0.26s">
          <a
            href="/get-started/"
            class="border border-blue bg-blue px-5 py-2.5 font-mono text-[0.85rem] text-white transition-colors hover:bg-[#1c2f73]">
            Get started
          </a>
          <a
            href="/how-it-works/"
            class="border border-rule bg-surface px-5 py-2.5 font-mono text-[0.85rem] text-blue transition-colors hover:border-keyline">
            How it works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What your members see -->
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <SectionHead
        eyebrow="The served surface"
        title="What your members see"
        lede="An answer from a deployment carries its own evidence. The rendering below is illustrative of the served format; every element in it is produced by a mechanism described on this site."
      />
      <div class="mt-10">
        <AnswerCard />
      </div>
      <p class="mt-8 font-mono text-[0.8rem] text-blue">
        <a href="/use-cases/" class="hover:text-keyline">The jobs this surface serves → Use cases</a>
      </p>
    </div>
  </section>

  <!-- What you already have -->
  <section class="border-b border-rule" id="what-you-have">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <SectionHead
        eyebrow="The inventory"
        title="What you already have"
        lede="Every artifact below is structure your organization has already paid to author. Konneal picks each one up where it stands, and each one raises what your members get."
      />
      <div class="mt-10 overflow-hidden border border-rule">
        {
          INVENTORY.map((row) => (
            <div class="grid gap-3 border-b border-rule bg-surface p-5 last:border-b-0 sm:grid-cols-[13rem_minmax(0,1fr)] sm:items-center sm:gap-6 sm:p-6">
              <div class="flex flex-wrap items-center gap-2">
                <AssetTag id={row.asset} />
              </div>
              <p class="text-[0.95rem] leading-relaxed text-ink-soft">{row.gets}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-ink-faint">
        A filled tag marks the baseline that a Metanorma library already provides; an outlined tag marks what a
        further asset adds.
      </p>
      <div class="mt-8 flex flex-wrap gap-6 font-mono text-[0.8rem] text-blue">
        <a href="/features/" class="hover:text-keyline">The full catalog, feature by feature → Features</a>
        <a href="/get-started/" class="hover:text-keyline">Your path from here → Get started</a>
      </div>
    </div>
  </section>

  <!-- How that is possible -->
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <SectionHead
        eyebrow="The suite"
        title="How that is possible"
        lede="Three layers make it possible: the documents are authored with structure, the rules are modelled as machines, and the serving layer anneals and serves the result."
      />
      <div class="mt-10 grid gap-px overflow-hidden border border-rule bg-rule md:grid-cols-3">
        {
          SUITE.map((s, i) => (
            <article class="bg-surface p-7">
              <p class="flex items-baseline justify-between font-mono text-[0.72rem] text-ink-faint">
                <span>{String(i + 1).padStart(2, '0')}</span>
                {s.href ? (
                  <a href={s.href} class="text-blue hover:text-keyline">
                    {s.tool} ↗
                  </a>
                ) : (
                  <span class="text-blue">{s.tool}</span>
                )}
              </p>
              <h3 class="mt-4 font-sans text-[1.2rem] font-semibold">{s.layer}</h3>
              <p class="mt-3 text-[0.93rem] leading-relaxed text-ink-soft">{s.what}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 font-mono text-[0.8rem] text-blue">
        <a href="/how-it-works/" class="hover:text-keyline">The machinery, end to end → How it works</a>
      </p>
    </div>
  </section>

  <!-- Evidence -->
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="border border-blue/25 bg-surface p-8 sm:p-10">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-xl">
            <p class="eyebrow"><span class="tick"></span>Evidence</p>
            <h2 class="mt-3 font-sans text-[1.5rem] font-semibold leading-tight">The public reference deployment</h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">
              Konneal serves a live, public deployment over a real standards corpus today. Every claim on this site
              about answers, citations and verdicts can be tested there by anyone.
            </p>
          </div>
          <div class="flex flex-col items-start gap-3 lg:items-end">
            <a
              href={SITE.reference.url}
              class="border border-blue bg-blue px-5 py-2.5 font-mono text-[0.85rem] text-white transition-colors hover:bg-[#1c2f73]">
              {SITE.reference.url.replace('https://', '')} ↗
            </a>
            <a href="/deployments/" class="font-mono text-[0.8rem] text-blue hover:text-keyline">
              What the deployment demonstrates → Deployments
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing band -->
  <section class="on-night bg-night">
    <div class="mx-auto max-w-6xl px-5 py-16 text-ramp-hi sm:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow"><span class="tick"></span>Get started</p>
        <h2 class="mt-3 font-sans text-[1.7rem] font-semibold leading-tight text-white sm:text-[2rem]">
          Adoption starts with a Metanorma library.
        </h2>
        <p class="mt-4 text-[1rem] leading-relaxed text-ramp-hi/80">
          If your organization authors in Metanorma, the grounded answering surface is available from day one. Every
          asset you add on top — identifiers, bibliographies, terminology, models — raises the annealment your members
          get.
        </p>
        <a
          href="/get-started/"
          class="mt-7 inline-block border border-ramp-lo px-5 py-2.5 font-mono text-[0.85rem] text-ramp-lo transition-colors hover:bg-ramp-lo/10 hover:text-white">
          The adoption paths →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
