---
import BaseLayout from '~/layouts/BaseLayout.astro'
import SectionHead from '~/components/SectionHead.astro'
import AssetTag from '~/components/AssetTag.astro'
import { ADOPTION, ENGAGEMENT, SITE } from '~/data/site'
---

<BaseLayout
  title="Get started"
  description="Adoption starts with a Metanorma library; every further asset — Pubid, Relaton, Glossarist, Lutaml, Primmel — raises the annealment."
>
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 pb-12 pt-14 sm:px-8 sm:pt-16">
      <p class="eyebrow"><span class="tick"></span>Get started</p>
      <h1 class="mt-4 max-w-3xl font-sans text-[2.1rem] font-semibold leading-[1.1] tracking-[-0.01em] sm:text-[2.7rem]">
        Adoption starts with a Metanorma library.
      </h1>
      <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-ink-soft">
        There is no qualification exercise and no migration project to pass first. Adoption follows the assets your
        organization already owns, and each profile below is a working starting point.
      </p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        eyebrow="Adoption"
        title="Adoption profiles"
        lede="Match your organization to what it already has; the engagement steps are the same for all three profiles."
      />
      <div class="mt-10 grid gap-px overflow-hidden border border-rule bg-rule lg:grid-cols-3">
        {
          ADOPTION.map((p) => (
            <article class="bg-surface p-7">
              <p class="flex flex-wrap gap-2">
                {p.assets.map((a) => (
                  <AssetTag id={a} />
                ))}
              </p>
              <h3 class="mt-4 font-sans text-[1.2rem] font-semibold leading-snug">{p.profile}</h3>
              <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-soft">{p.body}</p>
              <p class="mt-4 border-t border-rule pt-3 text-[0.82rem] leading-relaxed text-ink-faint">{p.path}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-faint">
        If your organization does not yet author in Metanorma, the lattice starts at authoring —
        <a
          href="https://www.metanorma.org"
          class="text-blue underline decoration-rule underline-offset-4 hover:decoration-keyline">metanorma.org ↗</a
        >
        is where that begins.
      </p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <SectionHead
        eyebrow="Process"
        title="Engagement"
        lede="Each step is measured, and each outcome — profile, corpus, deployment — belongs to your organization."
      />
      <ol class="mt-10 grid gap-px overflow-hidden border border-rule bg-rule md:grid-cols-2 lg:grid-cols-4">
        {
          ENGAGEMENT.map((s) => (
            <li class="bg-surface p-7">
              <p class="font-mono text-[0.72rem] text-blue">{s.step}</p>
              <h3 class="mt-3 font-sans text-[1.05rem] font-semibold">{s.name}</h3>
              <p class="mt-2.5 text-[0.88rem] leading-relaxed text-ink-soft">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="border border-blue/25 bg-surface p-8 sm:p-10">
          <p class="eyebrow"><span class="tick"></span>Talk to us</p>
          <h2 class="mt-3 font-sans text-[1.4rem] font-semibold leading-tight">Contact Ribose</h2>
          <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-soft">
            Konneal is developed by Ribose Inc. Pricing is by engagement — contact Ribose to begin the inventory
            review, or to discuss a deployment for your organization.
          </p>
          <a
            href={SITE.company.url}
            class="mt-6 inline-block border border-blue bg-blue px-5 py-2.5 font-mono text-[0.85rem] text-white transition-colors hover:bg-[#1c2f73]"
            rel="noopener"
          >
            {SITE.company.url.replace('https://', '')} ↗
          </a>
        </div>
        <div class="border border-rule bg-surface p-8 sm:p-10">
          <p class="eyebrow"><span class="tick"></span>See it working first</p>
          <h2 class="mt-3 font-sans text-[1.4rem] font-semibold leading-tight">A public deployment you can question</h2>
          <p class="mt-4 text-[0.95rem] leading-relaxed text-ink-soft">
            The fastest way to understand what a deployment does is to question a live one. Ask it about a clause, ask
            it for a verdict, and follow a citation into the original document.
          </p>
          <a
            href={SITE.reference.url}
            class="mt-6 inline-block border border-rule px-5 py-2.5 font-mono text-[0.85rem] text-blue transition-colors hover:border-keyline"
          >
            {SITE.reference.url.replace('https://', '')} ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
