---
import BaseLayout from '~/layouts/BaseLayout.astro'
---

<BaseLayout title="Not found" description="This page does not exist.">
  <section class="on-night bg-night">
    <div class="mx-auto max-w-6xl px-5 py-28 sm:px-8">
      <p class="eyebrow"><span class="tick"></span>404 · clause not found</p>
      <h1 class="mt-4 font-serif text-[2.2rem] font-medium leading-tight text-white sm:text-[2.8rem]">
        This page does not exist.
      </h1>
      <p class="mt-4 max-w-xl text-[1rem] leading-relaxed text-ramp-hi/75">
        There is nothing at this address — enumerated, zero matches. The pages that do exist are linked below.
      </p>
      <a
        href="/"
        class="mt-8 inline-block border border-ramp-lo px-5 py-2.5 font-mono text-[0.85rem] text-ramp-lo transition-colors hover:bg-ramp-lo/10 hover:text-white"
      >
        ← konneal.org
      </a>
    </div>
  </section>
</BaseLayout>
