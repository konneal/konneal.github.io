---
import BaseLayout from '~/layouts/BaseLayout.astro'
---

<BaseLayout title="Not found" description="This page does not exist.">
  <section class="on-night bg-night">
    <div class="mx-auto max-w-6xl px-5 py-28 sm:px-8">
      <p class="eyebrow"><span class="tick"></span>404 · page not found</p>
      <h1 class="mt-4 font-sans text-[2.1rem] font-semibold leading-tight text-white sm:text-[2.6rem]">
        There is nothing at this address.
      </h1>
      <p class="mt-4 max-w-xl text-[1rem] leading-relaxed text-ramp-hi/75">
        The site’s pages are linked from the footer below.
      </p>
      <a
        href="/"
        class="mt-8 inline-block border border-ramp-lo px-5 py-2.5 font-mono text-[0.85rem] text-ramp-lo transition-colors hover:bg-ramp-lo/10 hover:text-white">
        ← konneal.org
      </a>
    </div>
  </section>
</BaseLayout>
