---
import Logo from '~/components/Logo.astro'
import { SITE } from '~/data/site'
const year = new Date().getFullYear()

const columns = [
  {
    head: 'Product',
    links: [
      { label: 'Features', href: '/features/' },
      { label: 'How it works', href: '/how-it-works/' },
      { label: 'Annealment', href: '/annealment/' },
      { label: 'Use cases', href: '/use-cases/' },
    ],
  },
  {
    head: 'Solutions',
    links: [
      { label: 'Audiences', href: '/audiences/' },
      { label: 'Deployments', href: '/deployments/' },
      { label: 'Get started', href: '/get-started/' },
    ],
  },
  {
    head: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: `${SITE.company.name} ↗`, href: SITE.company.url },
    ],
  },
  {
    head: 'Reference',
    links: [
      { label: `${SITE.reference.name} ↗`, href: SITE.reference.url },
      { label: 'Metanorma ↗', href: 'https://www.metanorma.org' },
    ],
  },
]
---

<footer class="on-night bg-night text-ramp-hi">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-xs">
        <Logo variant="dark" lockup="domain" />
        <p class="mt-5 text-sm leading-relaxed text-ramp-hi/70">
          Konneal serves a standards organization’s own publications as a question-answering service.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-12 gap-y-8 sm:grid-cols-4">
        {
          columns.map((col) => (
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ramp-lo">{col.head}</p>
              <ul class="mt-3 space-y-2 text-sm">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="text-ramp-hi/85 hover:text-white">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[0.8rem] text-ramp-hi/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year}
        <a href={SITE.company.url} class="hover:text-ramp-hi" rel="noopener">{SITE.company.name}</a>
        · konneal.org
      </p>
    </div>
  </div>
</footer>
