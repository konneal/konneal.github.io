---
import Logo from './Logo.astro'
import { NAV, SITE } from '~/data/site'
const year = new Date().getFullYear()
---

<footer class="on-night bg-night text-ramp-hi">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <Logo variant="dark" lockup="domain" />
        <p class="mt-5 text-sm leading-relaxed text-ramp-hi/70">
          Knowledge annealment for standards. Authored in Metanorma, modelled in Primmel, served by Konneal.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ramp-lo">Site</p>
          <ul class="mt-3 space-y-2 text-sm">
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} class="text-ramp-hi/85 hover:text-white">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ramp-lo">Suite</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="https://www.metanorma.org" class="text-ramp-hi/85 hover:text-white">Metanorma ↗</a></li>
            <li><span class="text-ramp-hi/85">Primmel</span></li>
            <li><span class="text-white">Konneal</span></li>
          </ul>
        </div>
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ramp-lo">Reference</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a href={SITE.reference.url} class="text-ramp-hi/85 hover:text-white">{SITE.reference.name} ↗</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[0.8rem] text-ramp-hi/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Konneal · konneal.org</p>
      <p class="font-mono text-[0.72rem]">Answers cited to the clause · verdicts computed from the rule</p>
    </div>
  </div>
</footer>
