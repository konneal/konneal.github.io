---
import Logo from './Logo.astro'
import { NAV, SITE } from '~/data/site'

const path = Astro.url.pathname
const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`)
const isActive = (href: string) => norm(path) === norm(href)
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="flex flex-none items-center" aria-label="Konneal home">
      <Logo variant="light" lockup="primary" />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Site">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'px-2.5 text-[0.88rem] transition-colors',
              isActive(item.href) ? 'font-medium text-ink' : 'text-ink-soft hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={SITE.reference.url}
        class="border border-rule bg-surface px-3 py-1.5 font-mono text-[0.75rem] text-blue transition-colors hover:border-keyline"
      >
        {SITE.reference.url.replace('https://', '')}&nbsp;↗
      </a>
      <a
        href="/get-started/"
        class="border border-blue bg-blue px-4 py-1.5 font-mono text-[0.78rem] text-white transition-colors hover:bg-[#1c2f73]"
      >
        Get started
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border border-rule bg-surface"
        aria-label="Menu"
      >
        <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true">
          <path d="M0 1h16M0 5h16M0 9h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 top-12 z-50 flex w-72 flex-col border border-rule bg-surface p-4 shadow-lg"
        aria-label="Site"
      >
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'border-b border-rule px-2 py-2.5 text-[0.95rem] last:border-b-0',
                isActive(item.href) ? 'font-medium text-blue' : 'text-ink-soft',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a href="/get-started/" class="mt-3 border border-blue bg-blue px-3 py-2 text-center font-mono text-[0.8rem] text-white">
          Get started
        </a>
        <a
          href={SITE.reference.url}
          class="mt-2 border border-rule px-3 py-2 text-center font-mono text-[0.78rem] text-blue"
        >
          {SITE.reference.url.replace('https://', '')} ↗
        </a>
      </nav>
    </details>
  </div>
</header>
