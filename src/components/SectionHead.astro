---
interface Props {
  title: string
  lede?: string
}
const { title, lede } = Astro.props
---

<div class="max-w-3xl">
  <h2 class="font-sans text-[1.6rem] font-semibold leading-[1.2] tracking-[-0.008em] text-ink sm:text-[1.9rem]">
    {title}
  </h2>
  {lede && <p class="mt-4 text-[1rem] leading-relaxed text-ink-soft">{lede}</p>}
</div>
